# Copiar para .env e preencher. Nunca commitar o ficheiro .env.

# Ligação ao Postgres local (docker-compose.yml; credenciais só de desenvolvimento)
DATABASE_URL=postgres://hyperradar:hyperradar@127.0.0.1:5432/hyperradar
# Opcional: base dos testes de integração (tem de terminar em _test; omissão: hyperradar_test)
# TEST_DATABASE_URL=postgres://hyperradar:hyperradar@127.0.0.1:5432/hyperradar_test

# OpenAI (usada apenas por ação manual do utilizador). Sem chave, a Análise IA fica
# indisponível e o resto da aplicação funciona normalmente. Nunca commitar a chave.
OPENAI_API_KEY=
# Vazio = gpt-6.1-sol (omissão; alternativas: gpt-6.1-terra, mais barato; gpt-6-astra, premium)
OPENAI_MODEL=

# Porta da API (escuta sempre em 127.0.0.1)
PORT=3000

# Origens extra aceites em pedidos que alteram dados (omissão: dev server Vite em :5173)
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Intervalo de recolha de dados, em segundos
POLL_INTERVAL_SECONDS=60

# Dias de retenção dos snapshots (omissão 30; eventos e relatórios não são apagados)
SNAPSHOT_RETENTION_DAYS=30

# Número máximo de análises IA por dia
AI_DAILY_LIMIT=
