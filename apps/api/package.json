{
  "name": "@hyper-radar/api",
  "version": "0.0.0",
  "private": true,
  "description": "API do HyperRadar (Fastify).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hyper-radar/shared": "^0.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15"
  }
}
